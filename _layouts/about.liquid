---
layout: default
---
<div class="post about">
  {% assign subtitle_parts = page.subtitle | split: ' | ' %}
  <header class="hero">
    <div class="hero-text">
      {% if subtitle_parts.size > 0 %}
        <p class="hero-eyebrow">{{ subtitle_parts.first }}</p>
      {% endif %}
      <h1 class="hero-title">
        {% if site.title == 'blank' %}
          <span class="hero-first">{{ site.first_name }}</span>
          {% if site.middle_name %}{{ site.middle_name }}{% endif %}
          <span class="hero-last">{{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if subtitle_parts.size > 1 %}
        <ul class="hero-credentials">
          {% for part in subtitle_parts offset: 1 %}
            <li>{{ part }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if page.profile.more_info %}
        <div class="hero-contact">{{ page.profile.more_info }}</div>
      {% endif %}
      <div class="hero-social social">{% include social.liquid %}</div>
    </div>

    {% if page.profile.image %}
      <div class="hero-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="hero-portrait-img" sizes="(min-width: 768px) 300px, 60vw" alt=page.profile.image
          cache_bust=true
        %}
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
      <p class="see-all"><a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a></p>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
