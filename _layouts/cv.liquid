---
layout: default
---
{% assign cv = site.data.cv %}
{% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
{% capture self_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
{% capture self_name_bold %}<strong>{{ self_name }}</strong>{% endcapture %}

<div class="post">
  <header class="post-header page-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="cv-page">
    {% if page.cv_pdf %}
      <div class="cv-download">
        <div class="cv-download-text">
          <p class="cv-download-title">Prefer a PDF?</p>
          <p class="cv-download-meta">
            The full CV as a printable document{% if cv.last_updated %} · Updated {{ cv.last_updated }}{% endif %}
          </p>
        </div>
        <div class="cv-download-actions">
          <a class="cv-download-button" href="{{ cv_pdf_url }}" download="{{ site.first_name }}_{{ site.last_name }}_CV.pdf">
            <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
            Download CV (PDF)
          </a>
          <a class="cv-view-link" href="{{ '/cv/pdf/' | relative_url }}">or view it in your browser</a>
        </div>
      </div>
    {% endif %}

    <nav class="cv-jump" aria-label="CV sections">
      {% for section in cv.sections %}
        <a href="#{{ section.title | slugify }}">{{ section.title }}</a>
      {% endfor %}
    </nav>

    {% for section in cv.sections %}
      <section class="cv-section{% if section.style == 'compact' %} cv-section-compact{% endif %}" id="{{ section.title | slugify }}">
        <h2 class="cv-section-title">{{ section.title }}</h2>
        <div class="cv-entries">
          {% for entry in section.entries %}
            <div class="cv-entry">
              {% if entry.authors %}
                <p class="cv-entry-authors">{{ entry.authors | replace: self_name, self_name_bold }}</p>
              {% endif %}
              <div class="cv-entry-head">
                <h3 class="cv-entry-title">
                  {% if entry.url %}
                    <a href="{{ entry.url }}">{{ entry.title }}</a>
                  {% else %}
                    {{ entry.title }}
                  {% endif %}
                </h3>
                {% if entry.date %}
                  <span class="cv-entry-date">{{ entry.date }}</span>
                {% endif %}
              </div>
              {% if entry.org %}
                <p class="cv-entry-org">{{ entry.org }}</p>
              {% endif %}
              {% if entry.notes %}
                <dl class="cv-entry-notes">
                  {% for note in entry.notes %}
                    <dt>{{ note.label }}</dt>
                    <dd>{{ note.text }}</dd>
                  {% endfor %}
                </dl>
              {% endif %}
              {% if entry.bullets %}
                <ul class="cv-entry-bullets">
                  {% for bullet in entry.bullets %}
                    <li>{{ bullet }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </article>
</div>
